#!/bin/sh
# Only the gateway owns this socket. Its parent is not made world writable.
set -eu
socket=/fn-target/run/woodpecker.sock
if [ -e "$socket" ] && [ ! -S "$socket" ]; then
    printf '%s\n' 'Gateway socket path is occupied by a non-socket object.' >&2
    exit 1
fi
rm -f "$socket"
nginx -t
nginx -g 'daemon off;' &
gateway_pid=$!
trap 'kill -TERM "$gateway_pid" 2>/dev/null || true; wait "$gateway_pid" 2>/dev/null || true; exit 0' TERM INT
attempt=0
while [ ! -S "$socket" ]; do
    kill -0 "$gateway_pid" 2>/dev/null || { wait "$gateway_pid"; exit 1; }
    attempt=$((attempt + 1))
    [ "$attempt" -le 50 ] || { kill -TERM "$gateway_pid"; exit 1; }
    sleep 0.1
done
# Resolve the host's actual www-data GID during lifecycle preparation.
gateway_gid=$(cat /fn-target/run/gateway-gid)
case "$gateway_gid" in ''|*[!0-9]*) exit 1 ;; esac
chown "0:$gateway_gid" "$socket"
chmod 0660 "$socket"
wait "$gateway_pid"
